<div class="container">


    <h1>Build this week's plan</h1>
      <div  data-search-target="mealCards" data-category-target="mealCards" >

        <% @categories.each do |category| %>
          <div
            data-category-target="category"
            data-category-name="<%= category %>">
          </div>
        <% end %>
      </div>

    <div class="sidebar" data-meal-plan-review-target="sidebar">
      <%= turbo_frame_tag "review_sidebar" do %>
        <%= render "shared/sidenav", recipes: @recipes %>
      <% end %>
    </div>
</div>
