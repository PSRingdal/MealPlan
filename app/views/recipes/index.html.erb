<div class="container ">
  <h1>Build a meal plan</h1>

  <div class="search-recipe" data-controller="search category meal-plan-review">
    <form data-search-target="form" data-action="submit->search#submit">
      <div class="form-group d-flex">
        <input type="text" class="form-control" data-search-target="inputField">
        <button type="submit" class="btn btn-secondary">Search</button>
      </div>
    </form>

    <div  data-search-target="mealCards" data-category-target="mealCards" >
      <% @categories.each do |category| %>
        <div
          data-category-target="category"
          data-category-name="<%= category %>">
        </div>
      <% end %>
    </div>
      <div class="selected-meals d-none" data-category-target="selectedMeals">
      <%= link_to "Build plan", meal_plans_review_path, class: "bottom-btn btn btn-secondary", data: { action: "click->meal-plan-review#review" } %>
        <p class="selected-info">
          Selected <span data-category-target="selectedCount">0</span>
        </p>
      </div>
  </div>



</div>
