  <div class="">
    <div class="card-wrapper row" data-controller="recipe-show">
      <div class="col-6">
        <%= link_to recipes_path, class: "back-link" do %>
          <i class="fa-solid fa-arrow-left"></i> Back to recipes
        <% end %>

        <div class="img-wrapper">
          <img src="<%= @recipe["strMealThumb"] %>" class="show-card-img">
        </div>

        <div class="recipe-body-card">
          <h3>Ingredients</h3>
          <ul class="ingredients-list" data-recipe-show-target="ingredientList">
            <% @ingredient = (1..20).filter_map do |i| %>
              <% ingredient = @recipe["strIngredient#{i}"] %>
              <% mesure = @recipe["strMeasure#{i}"] %>
              <% unless ingredient.blank?  || mesure.blank?%>
                <div class="ingredient-row">
                  <li><%=ingredient%></li>
                  <li><%= mesure %></li>
                </div>
              <% end %>
            <% end %>
          </ul>
        </div>

      </div>

      <div class="col-6">

        <div class="recipe-info-card">

          <h2 class="mb-3"> <%= @recipe["strMeal"] %></h2>

          <div class="show-recipe-info d-flex gap-4 mb-4">
            <div>
              <span>category</span>
              <h3><%= @recipe["strCategory"] %></h3>
            </div>

            <div>
              <span>cuisine</span>
              <h3><%= @recipe["strArea"] %></h3>
            </div>

            <div>
              <span>ingredients</span>
              <h3><%= @ingredient.size %></h3>
            </div>
          </div>

          <div class="d-flex gap-3">
            <button class="add-recipe-btn btn"
            data-action="click->meal-selection#selectMeal click->meal-plan-review#review"
            data-category-target="addBtn" >
              <div class="add-btn-div d-flex gap-3" >
                <i class="fa-solid fa-plus toggle-icon"
                  data-meal-id= "<%= @recipe["idMeal"]  %>"
                  data-meal-selection-target="icon"
                  data-category-target="icon"
                  data-meal-plan-review-target="addIcon"></i>
                  <span> Add to plan </span>
              </div>
            </button>

            <% if @existing_recipe.present? %>
              <%= button_to unsave_recipe_path(@existing_recipe), class: "show-save-btn" do %>
                <i class="fa-solid fa-heart save-fav"></i>
              <% end %>
            <% else %>
              <%= button_to save_recipe_path(@recipe), class: "show-save-btn" do %>
              <i class="fa-regular fa-heart"></i>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="recipe-body-card">
          <h3>Methode</h3>
           <div data-recipe-show-target="instructions">
              <% instructions = @recipe["strInstructions"].split(/\r?\n/)
              .map(&:strip)
              .reject(&:empty?)
              .map { |line| line.sub(/^\s*(step\s*\d+[:.)-]?\s*|\d+[:.)-]\s*)/i, "") }
              .reject(&:empty?)
              .reject { |line| line.match?(/\A\d+\z/) } %>

              <ol>
                <% instructions.each do |value| %>
                  <li class="instructions-list"><%="#{value}"%></li>
                <% end %>
              </ol>
            </div>
        </div>

      </div>
    </div>
  </div>
