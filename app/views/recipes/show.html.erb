  <div class="">
    <div class="card-wrapper row" data-controller="recipe-show">
      <div class="col-6">
        <div class="img-wrapper">
          <img src="<%= @recipe["strMealThumb"] %>" class="show-card-img">
        </div>

        <div class="recipe-body-card">
          <%# <button class="btn btn-success" data-action="click->recipe-show#ingredients">Ingredients</button> %>
          <%# <button class="btn btn-success" data-action="click->recipe-show#instructions">Instructions</button> %>
          <h3>Ingredients</h3>
          <ul class="ingredients-list" data-recipe-show-target="ingredientList">
            <% @ingredient = (1..20).filter_map do |i| %>
              <% ingredient = @recipe["strIngredient#{i}"] %>
              <% mesure = @recipe["strMeasure#{i}"] %>
              <% unless ingredient.blank?  || mesure.blank?%>
                <div class="ingredient-row">
                  <li><%=ingredient%></li>
                  <li><%= mesure %></li>
                </div>
              <% end %>
            <% end %>
          </ul>
        </div>

      </div>

      <div class="col-6">

        <div class="recipe-info-card">
        <% if @recipe["strTags"].present? %>
          <% tag = @recipe["strTags"].split(",")%>
            <div class=" tags d-flex gap-3">
              <span class="rounded-pill"><%=tag[0]%></span>
              <span class="rounded-pill"><%=tag[1]%></span>
            </div>
          <% end %>

          <h2 class="mb-3"> <%= @recipe["strMeal"] %></h2>

          <div class="show-recipe-info d-flex gap-4 mb-4">
            <div>
              <span>category</span>
              <h3><%= @recipe["strCategory"] %></h3>
            </div>

            <div>
              <span>cuisine</span>
              <h3><%= @recipe["strArea"] %></h3>
            </div>

            <div>
              <span>ingredients</span>
              <h3><%= @ingredient.size %></h3>
            </div>
          </div>

          <div class="d-flex gap-3">
            <button class="show-info-btn btn">+ Add recipe</button>
            <i class="fa-solid fa-bookmark"></i>
          </div>
        </div>

        <div class="recipe-body-card">
          <h3>Methode</h3>
           <div data-recipe-show-target="instructions">
              <% instructions = @recipe["strInstructions"].split(/\r?\n/)
              .map(&:strip)
              .reject(&:empty?)
              .map { |line| line.sub(/^\s*(step\s*\d+[:.)-]?\s*|\d+[:.)-]\s*)/i, "") }
              .reject(&:empty?)
              .reject { |line| line.match?(/\A\d+\z/) } %>

              <ol>
                <% instructions.each do |value| %>
                  <li class="instructions-list"><%="#{value}"%></li>
                <% end %>
              </ol>
            </div>
        </div>

      </div>
    </div>
  </div>
