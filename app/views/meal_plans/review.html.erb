<div class="container">

  <h1>Review your plan</h1>
  <div data-controller="meal-plam-review">
    <div data-categoty-target="reviewMealPlan">
      <% @recipes.each do |recipe|%>

      <a href=" /recipes/<%= recipe["idMeal"] %>">
        <div class="review-card">
          <img class="review-img" src="<%=recipe["strMealThumb"] %>">
          <div class="card-body">
            <h2><%= recipe["strMeal"]%></h2>
          </div>
        </div>
      </a>
      <% end %>
    </div>
    <%= link_to "Build this Meal Plan",  meal_plans_path, data: { turbo_method: :post },  class: "btn btn-secondary"  %>
  </div>
</div>
