<div class="container" data-controller="meal-plan">
  <div class="row">
      <div class="meal-plan-hero">
        <h1>Your meal plans</h1>
        <p>View and manage the recipes you've added to your meal plan</p>
      </div>

      <div class="col-8">
        <div class="meal-plan-container">
          <% sorted_dates = @meal_plans_by_date.sort { |a, b| b <=> a } %>
          <% sorted_dates.each do |date, meal_plan|%>
            <div class=" meal-plan-card-wrapper bg-white  px-3 mb-3 d-flex flex-column ">
              <div class="day-heading ">
                <h2><%= date_label(date) %></h2>
                <span class="date-label"> <%=(date.strftime ("%a %d %b"))%></span>
              </div>

              <% meal_plan.each do |plan| %>
                <% plan.meal_plan_recipes.each do |meal_plan_recipe| %>
                  <% recipe = meal_plan_recipe.recipe %>
                  <div class="meal-plan-card d-flex align-items-center py-3 border-bottom rounded-0 justify-content-between">
                    <%= link_to recipe_path(recipe.external_id), class: "navigation-link d-flex align-items-center gap-3" do %>
                      <%= image_tag recipe.image_url, class: "meal-plan-img" %>
                      <h3 class="meal-title"><%= recipe.title %></h3>
                      <span><%= recipe.category %></span>
                    <% end %>

                    <%= button_to meal_plan_meal_plan_recipe_path(plan, meal_plan_recipe), method: :delete, class: "meal-plan-remove-btn" do %>
                      <i class="fa-solid fa-x"></i>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="col-4">
        <div class="add-meal-card bg-white border">
          <h2>
            <i class="fa-solid fa-cart-shopping"></i>
            Grocery list
          </h2>

          <% @ingredients.each do |ingredient, count| %>
            <p>
              <%= ingredient %>
              <% if count > 1 %>
                x <%= count %>
              <% end %>
            </p>
          <% end %>
        <div>
          <button class="btn border rounded-pill add-meal-btn"> + Copy list</button>
        </div>
      </div>
    </div>
  </div>
