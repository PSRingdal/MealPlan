<div class="container">
  <div class="meal-plan-hero">
    <h1>Your meal plans</h1>
    <p>View and manage the recipes you've added to your meal plan</p>
  </div>
  <div class="cards-container">
    <% @meal_plans.each do |meal_plan|%>
      <%  meal_plan.recipes.each do |recipe| %>
        <div >
          <div class="card mb-4">
            <%= image_tag recipe.image_url %>
            <%= recipe.title  %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
