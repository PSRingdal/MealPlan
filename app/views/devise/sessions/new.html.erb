<div class="container">
  <div class="d-flex justify-content-center align-items-center gap-5 pt-5">

    <%= image_tag "pokebowl.jpg",
        alt: "Poke bowl",
        class: "sign-in-img" %>

    <div class="form-wrapper">
      <h2>Log in</h2>

      <%= simple_form_for(resource,
          as: resource_name,
          url: session_path(resource_name)) do |f| %>

        <%= f.input :email,
            required: false,
            autofocus: true,
            input_html: { autocomplete: "email" } %>

        <%= f.input :password,
            required: false,
            input_html: { autocomplete: "current-password" } %>

        <%= f.input :remember_me,
            as: :boolean if devise_mapping.rememberable? %>

        <%= f.button :submit,
            "Log in",
            class: "btn btn-dark w-100" %>

      <% end %>

    </div>

  </div>
</div>
``
