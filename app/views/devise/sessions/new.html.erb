<div class="row g-0 min-vh-100">

  <div class="col-6 d-flex align-items-center justify-content-center">
    <div class="login-width">

      <%= link_to root_path, class: "login-brand" do %>
        <span class="login-brand-icon"><i class="fa-solid fa-utensils"></i></span>
        Easy Plate
      <% end %>

      <h1>Welcome back</h1>
      <p class="login-sub">Plan your week and shop from one list.</p>

      <%= simple_form_for(resource,
            as: resource_name,
            url: session_path(resource_name)) do |f| %>

        <%= f.input :email,
              required: false,
              autofocus: true,
              input_html: { autocomplete: "email" } %>

        <%= f.input :password,
              required: false,
              input_html: { autocomplete: "current-password" } %>

        <%= f.input :remember_me,
              as: :boolean if devise_mapping.rememberable? %>

        <%= f.button :submit, "Log in", class: "btn btn-login w-100" %>
      <% end %>

      <p class="login-alt">
        New here?
        <%= link_to "Create an account", new_registration_path(resource_name) %>
      </p>

    </div>
  </div>

  <div class="col-6">
    <%= image_tag "pokebowl.jpg", alt: "A poke bowl", class: "sign-in-img" %>
  </div>

</div>
