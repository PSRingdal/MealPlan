  <div>
    <h1>Your plan</h1>
    <i class="fa-solid fa-xmark"></i>
  </div>
  <div data-controller="meal-plan-review">
    <div data-categoty-target="reviewMealPlan">
      <% recipes.each do |recipe|%>

      <a href=" /recipes/<%= recipe["idMeal"] %>">
        <div class="review-card">
          <img class="review-img" src="<%=recipe["strMealThumb"] %>">
          <div class="card-body">
            <h2><%= recipe["strMeal"]%></h2>
          </div>
        </div>
      </a>
      <% end %>
    </div>
    <%= link_to "Build your plan",  meal_plans_path, data: { turbo_method: :post, turbo_frame: "_top" }, class: "btn btn-secondary"  %>
  </div>
