  <div class=" sidebar-header d-flex align-items-center justify-content-between">
    <h1>Your plan</h1>
    <i class="fa-solid fa-xmark open-sidebar-btn" data-action="click->meal-plan-review#openSidebar"></i>
  </div>
  <div>
    <div data-categoty-target="reviewMealPlan">

      <div class="sidebar-content">
        <% (recipes || []).each do |recipe|%>

        <a href="/recipes/<%= recipe["idMeal"] %>" data-turbo-frame="_top">
          <div class="review-card d-flex justify-content-between" data-recipe-id=<%= recipe["idMeal"] %>>
            <div class="d-flex gap-3">
              <img class="review-img" src="<%=recipe["strMealThumb"] %>">
              <div class="review-body">
                <h2 class="review-meal"><%= recipe["strMeal"]%></h2>
                <small class="review-category"><%= recipe["strCategory"]%></small>
              </div>
            </div>
            <i class="fa-solid fa-circle-minus remove-btn", data-action="click->meal-plan-review#removeBtn"></i>
          </div>
        </a>
        <% end %>
      </div>
    </div>

    <div class="sidebar-footer" data-controller="meal-plan-builder">

      <button
        type="button"
        class="build-your-plan-btn btn w-100"
        data-action="click->meal-plan-builder#toggle"
        data-meal-plan-builder-target="button">
        Build your plan
      </button>

      <div class="d-none" data-meal-plan-builder-target="form">

      <%= form_with url: meal_plans_path, method: :post, data: { turbo_frame: "_top", action: "submit->meal-plan-builder#clearSelection" } do |form| %>
          <%= form.label :plan_date, "Select date",
              class: "form-label mb-2" %>

          <%= form.date_field :plan_date,
              class: "form-control mb-3",
              value: Date.current %>

          <%= form.submit "Build Plan",
              class: "build-your-plan-btn btn w-100" %>
        <% end %>

        <button
          type="button"
          class="btn btn-link w-100 mt-2"
          data-action="click->meal-plan-builder#toggle">
          Cancel
        </button>

      </div>

    </div>
  </div>
