  <div class=" sidebar-header d-flex align-items-center justify-content-between">
    <h1>Your plan</h1>
    <i class="fa-solid fa-xmark" data-action="click->meal-plan-review#openSidebar"></i>
  </div>
  <div>
    <div data-categoty-target="reviewMealPlan">

      <div class="sidebar-content">
        <% recipes.each do |recipe|%>

        <a href="/recipes/<%= recipe["idMeal"] %>" data-turbo-frame="_top">
          <div class="review-card d-flex justify-content-between" data-category-target="recipe" data-recipe-id=<%= recipe["idMeal"] %>>
            <div class="d-flex gap-3">
              <img class="review-img" src="<%=recipe["strMealThumb"] %>">
              <div class="review-body">
                <h2 class="review-meal"><%= recipe["strMeal"]%></h2>
                <small class="review-category"><%= recipe["strCategory"]%></small>
              </div>
            </div>
            <i class="fa-solid fa-circle-minus remove-btn", data-action="click->meal-plan-review#removeBtn"></i>
          </div>
        </a>
        <% end %>
      </div>
    </div>

    <div class="sidebar-footer">
      <%= link_to "Build your plan",  meal_plans_path, data: { turbo_method: :post, turbo_frame: "_top" }, class: " sidebar-btn btn w-100" %>
    </div>

  </div>
