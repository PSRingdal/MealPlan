<nav class="navbar navbar-expand-sm">
  <div class="container-fluid">

    <div class="d-flex align-items-center gap-3">
      <i class="fa-solid fa-utensils"></i>
      <%= link_to "Easy Plate", user_signed_in? ? meal_plans_path : pages_home_path, class: "navbar-header" %>
      <% if user_signed_in? %>
      <div class="page-navigation-wrapper d-flex gap-4">
        <%= link_to "Meal plans", meal_plans_path, class: "page-nav" %>
        <%= link_to "Browse recipes", recipes_path, class: "page-nav" %>
        <%= link_to "Favorites", recipes_saved_path, class: "page-nav" %>
      </div>

    </div>

      <div class="d-flex align-items-center gap-3">
        <% if current_page?(recipes_path) %>
        <form data-search-target="form" data-action="submit->search#submit">
          <div class="form-group d-flex align-items-center">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="nav-search form-control" data-search-target="inputField" placeholder="Search dishes, ingredients, cuisines...">
          </div>
        </form>
         <% end %>
        <div data-category-target="selectedMeals">
          <% if current_page?(recipes_path) || current_page?(recipes_saved_path) %>
            <%= turbo_frame_tag "review_count" do %>
              <button class="your-plan-btn btn btn-dark rounded-pill" data-action="click->meal-plan-review#openSidebar">
                Your plan <span data-meal-selection-target="selectedCount" data-meal-plan-review-target="recipeCount" class="selected-count"><%= @selected_meal_count %></span>
              </button>
            <% end %>
          <% end %>
        </div>
        <%= link_to settings_path do %>
          <i class="fa-solid fa-gear settings-btn"></i>
        <% end %>
      </div>
    <% else %>
      <ul class="navbar-nav">
        <li class="nav-item">
          <%= link_to "Log in", new_user_session_path, class: "nav-link" %>
        </li>
      </ul>
    <% end %>

  </div>
</nav>
