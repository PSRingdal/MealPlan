<nav class="navbar navbar-expand-sm">
  <div class="container-fluid">
      <% if user_signed_in? %>
        <div class="d-flex align-items-center gap-3">
          <i class="fa-solid fa-utensils"></i>
          <%= link_to "Easy Plate", meal_plans_path, class: "navbar-header"  %>
          <form data-search-target="form" data-action="submit->search#submit">
            <div class="form-group d-flex align-items-center">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="text" class="nav-search form-control" data-search-target="inputField" placeholder="Search dishes, ingredients, cuisines...">
            </div>
          </form>
        </div>

        <div class="d-flex align-items-center gap-3">
          <div data-category-target="selectedMeals">
            <% if current_page?(recipes_path) %>
            <button class=" your-plan-btn btn btn-dark rounded-pill" data-action="click->meal-plan-review#openSidebar">
               Your plan <span data-category-target="selectedCount" class="selected-count">0</span>
            </button>
            <% else %>
            <%= link_to "+ Add recipe", recipes_path, class: "btn btn-dark rounded-pill" %>
            <%end %>
          </div>
          <i class="fa-solid fa-gear"></i>
        </div>

      <% else %>
        <ul class="navbar-nav">
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        </ul>
      <% end %>
  </div>
</nav>
